# ─────────────────────────────────────────────────────────────────────────────
# Kisan Mitra — environment variables
#
# Copy this file to `.env` for local development:   cp .env.example .env
# NEVER commit a real `.env` (it is already in .gitignore).
#
# ⚠️  Values that were previously committed here have been revoked/rotated.
#     Generate fresh ones before deploying (see README → "Rotate your secrets").
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API key — powers the multilingual "Kisan Mitra Sahayak" assistant.
# Optional: without it the assistant answers from its built-in grounded knowledge base.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Public URL of the deployment (used for links / OG tags and CORS).
APP_URL="http://localhost:3000"

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Optional: when it is missing or unreachable the app runs on its in-memory
# store instead (data then resets on restart).
MONGODB_URI=""

# Secret used to sign login JWTs. Generate one with:  openssl rand -hex 32
# If unset, a random secret is generated at boot (sessions reset on restart).
JWT_SECRET=""

# Port the API server listens on. Hosting platforms (Render, Railway, …) inject
# their own PORT — the server always prefers the environment value.
PORT=3000

# data.gov.in AGMARKNET API credentials — live mandi price sync.
# Optional: without them the verified AGMARKNET baseline data set is used.
# Register at https://data.gov.in and use the AGMARKNET resource id.
DATA_GOV_IN_API_KEY=""
DATA_GOV_IN_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"

# How often the market-price sync job runs.
MARKET_SYNC_CRON="*/30 * * * *"
MARKET_SYNC_INTERVAL_MINUTES="30"

# Comma-separated list of origins allowed to call this API (your frontend URLs).
# Leave empty to allow all origins (the API already sends `Access-Control-Allow-Origin: *`).
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Frontend-only (Vite) variable. Leave UNSET when deploying to Render (the web app
# calls the same-origin /api automatically). When building the Android APK with
# Capacitor, set this to your deployed backend URL so the app can reach the API, e.g.:
# VITE_API_BASE_URL="https://your-app.onrender.com"
