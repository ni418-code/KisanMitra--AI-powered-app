# Server secrets / optional integrations
GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_random_jwt_secret_here
DATA_GOV_IN_API_KEY=your_data_gov_api_key_here
DATA_GOV_IN_RESOURCE_ID=your_resource_id_here

# Comma-separated frontend origins. For the same-origin Render demo, leave unset or use the Render URL.
CORS_ORIGIN=https://your-app.onrender.com,http://localhost:3000,http://localhost:5173

# Frontend-only variable. Leave unset for the Render web app (same-origin /api).
# Set this to the deployed backend URL only when building the Capacitor Android APK.
# VITE_API_BASE_URL=https://your-app.onrender.com
